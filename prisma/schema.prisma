datasource db {
    provider = "postgresql"
    url      = env("POSTGRES_URL")
}

generator client {
    provider             = "prisma-client-py"
    recursive_type_depth = -1
}

model User {
    discord_id BigInt @id
    name       String

    game_subscriptions GameSubscription[]
}

model LastTimePlayed {
    game_id     BigInt
    streamer_id BigInt
    last_time   DateTime @default(now())

    game     Game     @relation(fields: [game_id], references: [twitch_id])
    streamer Streamer @relation(fields: [streamer_id], references: [twitch_id])

    @@id([game_id, streamer_id], name: "game_streamer_unique")
}

model Game {
    twitch_id BigInt @id
    name      String
    image_url String

    last_time_played LastTimePlayed[]
    game_subscriptions GameSubscription[]
}

model Streamer {
    twitch_id BigInt @id
    name      String

    last_time_played LastTimePlayed[]
    game_subscriptions GameSubscription[]
}

model GameSubscription {
    user_discord_id    BigInt
    game_twitch_id     BigInt
    streamer_twitch_id BigInt
    created_at         DateTime @default(now())

    user     User     @relation(fields: [user_discord_id], references: [discord_id])
    game     Game     @relation(fields: [game_twitch_id], references: [twitch_id])
    streamer Streamer @relation(fields: [streamer_twitch_id], references: [twitch_id])

    @@id([user_discord_id, game_twitch_id, streamer_twitch_id], name: "user_game_streamer_unique")
}
